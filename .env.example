# Copy to .env in the project root. The backend loads it automatically.
# Existing process environment variables take precedence.
CQ_DATA_DIR=.data
CQ_EXTRACTION_MODEL=google:gemini-3.8-flash
# Paste your Google AI Studio / Gemini API key here in .env, not in this template.
GOOGLE_API_KEY=
# CQ_ML_URL=http://localhost:9001
# CQ_QUEUE_ENGINE_URL=http://localhost:9002
# Comma-separated dashboard origins, including scheme and port.
# CQ_CORS_ORIGINS=http://localhost:5173
# Directory containing cq-sim's prepared YEAR-POLICY.json results.
# CQ_SIMULATION_RESULTS_DIR=../cq-sim/results
