# Copy to .env in the project root. The backend loads it automatically.
# Existing process environment variables take precedence.
CQ_DATA_DIR=.data
CQ_EXTRACTION_MODEL=google:gemini-3.8-flash
# Paste your Google AI Studio / Gemini API key here in .env, not in this template.
GOOGLE_API_KEY=
